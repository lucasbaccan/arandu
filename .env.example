HOST=0.0.0.0
PORT=8080
# Segredo usado para assinar os tokens JWT de sessão.
# Gere um aleatório com:  openssl rand -hex 32
# (ou no PowerShell:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) }))
# Troque apenas se o segredo vazar; ao trocar, todas as sessões ativas são invalidadas.
JWT_SECRET=troque-por-um-segredo-forte
SESSION_HOURS=24
MIN_PASSWORD_LENGTH=3
DATABASE_PATH=./data/app.db
COOKIE_SECURE=false
SNOWFLAKE_NODE=0
