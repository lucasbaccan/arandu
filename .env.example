HOST=0.0.0.0
PORT=8888
# Segredo usado para assinar os tokens JWT de sessão.
# Gere um aleatório com:  openssl rand -hex 32
# (ou no PowerShell:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) }))
# Troque apenas se o segredo vazar; ao trocar, todas as sessões ativas são invalidadas.
JWT_SECRET=troque-por-um-segredo-forte
SESSION_HOURS=24
MIN_PASSWORD_LENGTH=3
DATABASE_PATH=./data/app.db
# Diretório onde as fotos dos participantes são materializadas em disco a partir do base64 do banco.
# Arquivos com mais de 7 dias são apagados pela limpeza diária e recriados quando solicitados.
PHOTOS_DIR=./data/photos
COOKIE_SECURE=false
# SameSite do cookie: lax (default) | none (cross-site, ex: frontend na Vercel — exige COOKIE_SECURE=true) | strict
COOKIE_SAMESITE=lax
# Origens liberadas no CORS, separadas por vírgula (ex: https://app.vercel.app,https://*.vercel.run)
# Sufixo "*." libera qualquer subdomínio. Vazio = sem headers CORS.
CORS_ORIGINS=
SNOWFLAKE_NODE=0
